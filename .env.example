# AttendX Flet connects to the EXISTING Supabase project used by AttendX-Web.
SUPABASE_URL=https://ligzoiktrdwcdqpkaudr.supabase.co

# REQUIRED for the Python Supabase Auth/PostgREST client.
# Copy the legacy anon/public key from Supabase Project Settings -> API Keys.
# Never use a service-role/secret key in this desktop app.
SUPABASE_ANON_KEY=

# Optional: publishable key for Edge Function requests, if available.
SUPABASE_PUBLISHABLE_KEY=

APP_TIMEZONE=Asia/Manila
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
QR_TOKEN_TTL_DAYS=180
FINGERPRINT_PORT=COM3
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_ADDRESS=4294967295
FINGERPRINT_PASSWORD=0
EXPORTS_DIR=exports
LOG_LEVEL=INFO
