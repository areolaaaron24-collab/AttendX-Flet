# Copy this file to .env and fill in values from your Supabase project.
# NEVER put a service-role/secret key in this file or in the desktop/mobile app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_KEY
# Older projects may use the anon key; use only the publishable/anon client key.
# SUPABASE_ANON_KEY=REPLACE_WITH_ANON_PUBLIC_KEY

APP_TIMEZONE=Asia/Manila
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
QR_TOKEN_TTL_DAYS=180
FINGERPRINT_PORT=COM3
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_ADDRESS=4294967295
FINGERPRINT_PASSWORD=0
EXPORTS_DIR=exports
LOG_LEVEL=INFO
