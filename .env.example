# Copy this file to .env and fill in values from the EXISTING AttendX Supabase project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# REQUIRED for the Python Supabase Auth/PostgREST client.
# Get the legacy anon/public key from Supabase Project Settings → API Keys.
# This is a public client key. Never put a server secret key in this desktop app.
SUPABASE_ANON_KEY=REPLACE_WITH_LEGACY_ANON_PUBLIC_KEY

# Optional: publishable key for Edge Function calls.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_KEY

APP_TIMEZONE=Asia/Manila
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
QR_TOKEN_TTL_DAYS=180
FINGERPRINT_PORT=COM3
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_ADDRESS=4294967295
FINGERPRINT_PASSWORD=0
EXPORTS_DIR=exports
LOG_LEVEL=INFO
