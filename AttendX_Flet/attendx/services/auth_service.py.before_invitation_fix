from __future__ import annotations

import logging
from typing import Any

import httpx
from supabase import Client

from attendx.core.config import Settings
from attendx.core.validators import RegistrationData
from attendx.services.supabase_client import BackendError, safe_message

log = logging.getLogger(__name__)


class AuthService:
    """Account-ID authentication delegated to Supabase Edge Functions.

    The desktop/mobile client contains only the public/publishable key. Edge functions
    use the server-side Supabase service-role secret; it must never be copied here.
    """

    def __init__(self, client: Client, settings: Settings):
        self.client = client
        self.settings = settings

    def _invoke(self, function_name: str, body: dict[str, Any]) -> dict[str, Any]:
        url = f"{self.settings.supabase_url}/functions/v1/{function_name}"
        headers = {
            "apikey": self.settings.supabase_key,
            "Authorization": f"Bearer {self.settings.supabase_key}",
            "Content-Type": "application/json",
        }
        try:
            response = httpx.post(url, headers=headers, json=body, timeout=httpx.Timeout(20.0, connect=8.0))
            try:
                payload = response.json()
            except ValueError:
                payload = {}
            if response.status_code >= 400:
                message = payload.get("error") or payload.get("message") or f"Server returned HTTP {response.status_code}."
                raise BackendError(str(message)[:400])
            if not isinstance(payload, dict):
                raise BackendError("The authentication service returned an invalid response.")
            return payload
        except httpx.TimeoutException as exc:
            raise BackendError("The server took too long to respond. Check your connection and try again.") from exc
        except httpx.HTTPError as exc:
            raise BackendError(f"Could not reach the authentication service: {safe_message(exc)}") from exc

    def register(self, data: RegistrationData) -> dict[str, Any]:
        payload = self._invoke("account-register", {
            "accountId": data.account_id,
            "role": data.role,
            "password": data.password,
            "firstName": data.first_name,
            "lastName": data.last_name,
            "middleName": data.middle_name or "",
            "suffix": data.suffix or "",
            "sex": data.sex,
            "recoveryEmail": data.recovery_email,
            "course": data.course,
            "yearLevel": data.year_level,
            "section": data.section,
            "department": data.department,
            "office": data.office,
        })
        self._apply_session(payload)
        return self._profile_for_session(data.role)

    def login(self, account_id: str, password: str, role: str) -> dict[str, Any]:
        payload = self._invoke("account-id-login", {
            "accountId": account_id,
            "role": role.upper(),
            "password": password,
        })
        self._apply_session(payload)
        profile = self._profile_for_session(role.upper())
        if profile.get("role") != role.upper():
            self.sign_out()
            raise BackendError("This account belongs to a different portal. Choose the correct portal and try again.")
        return profile

    def _apply_session(self, payload: dict[str, Any]) -> None:
        session = payload.get("session") or payload.get("data", {}).get("session")
        if not isinstance(session, dict):
            raise BackendError("The authentication service did not return a session. Check the Edge Function deployment.")
        access_token = session.get("access_token")
        refresh_token = session.get("refresh_token")
        if not access_token or not refresh_token:
            raise BackendError("The authentication service returned an incomplete session.")
        try:
            self.client.auth.set_session(access_token, refresh_token)
        except Exception as exc:
            log.exception("Unable to establish Supabase session")
            raise BackendError(f"Sign-in succeeded but the local session could not be established: {safe_message(exc)}") from exc

    def _profile_for_session(self, expected_role: str | None = None) -> dict[str, Any]:
        try:
            user_response = self.client.auth.get_user()
            user = getattr(user_response, "user", None)
            if user is None and hasattr(user_response, "data"):
                data = user_response.data
                user = data.get("user") if isinstance(data, dict) else None
            user_id = getattr(user, "id", None) if user is not None else None
            if not user_id and isinstance(user, dict):
                user_id = user.get("id")
            if not user_id:
                raise BackendError("The signed-in user could not be identified.")
            result = self.client.table("profiles").select("*").eq("id", user_id).limit(1).execute()
            data = getattr(result, "data", None) or []
            if not data:
                raise BackendError("Your account profile is not ready. Check the profile trigger in the database migration.")
            profile = data[0]
            if expected_role and profile.get("role") != expected_role:
                raise BackendError("The account role does not match the selected portal.")
            if not profile.get("is_active", True):
                self.sign_out()
                raise BackendError("This account is inactive. Contact your school administrator.")
            return profile
        except BackendError:
            raise
        except Exception as exc:
            raise BackendError(f"Could not load the account profile: {safe_message(exc)}") from exc

    def request_password_reset(self, account_id: str, role: str) -> None:
        # The function deliberately returns a generic acknowledgement to avoid account enumeration.
        self._invoke("account-password-reset", {"accountId": account_id, "role": role.upper()})

    def update_password(self, new_password: str) -> None:
        try:
            self.client.auth.update_user({"password": new_password})
        except Exception as exc:
            raise BackendError(f"Password update failed: {safe_message(exc)}") from exc

    def sign_out(self) -> None:
        try:
            self.client.auth.sign_out()
        except Exception:
            log.exception("Supabase sign-out had a recoverable error")
